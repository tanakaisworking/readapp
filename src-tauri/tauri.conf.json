{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "readapp",
  "version": "0.1.0",
  "identifier": "com.hibachi.readapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "readapp",
        "visible": false,
        "width": 400,
        "height": 680,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["readapp"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "binaries/fm-helper-aarch64-apple-darwin": "binaries/fm-helper-aarch64-apple-darwin",
      "resources/shortcuts/": "resources/shortcuts/",
      "resources/automation/": "resources/automation/",
      "gen/intents/Metadata.appintents/": "Metadata.appintents/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
